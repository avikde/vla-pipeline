<mujoco model="widowx_vision_scene">
  <!-- Include WidowX 250s robot -->
  <include file="wx250s.xml"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <headlight ambient="0.8 0.8 0.8"/>
    <global offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <!-- Wooden table material (light oak, matching BridgeData) -->
    <texture name="wood" type="2d" builtin="flat" rgb1="0.55 0.42 0.30" rgb2="0.50 0.38 0.26" width="512" height="512" mark="random" markrgb="0.35 0.25 0.18" random="0.05"/>
    <material name="wood" texture="wood" texrepeat="3 3" specular="0.1" shininess="0.1"/>
  </asset>

  <worldbody>

    <!-- Better lighting for vision -->
    <light pos="-0.3 0.3 1.0" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="-0.3 -0.3 0.8" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <!-- Wooden table (matching BridgeData setup) -->
    <body name="table" pos="0.3 0 -0.01">
      <geom name="table_top" type="box" size="0.2 0.5 0.01" material="wood"/>
    </body>

    <!-- Blocks -->
    <body name="red_block" pos="0.2 -0.1 0.02">
      <geom name="red_block_geom" type="box" size="0.02 0.02 0.02" rgba="0.8 0.1 0.1 1" mass="0.05"/>
      <freejoint/>
    </body>
    <body name="green_block" pos="0.15 0.05 0.02">
      <geom name="green_block_geom" type="box" size="0.02 0.02 0.02" rgba="0.1 0.8 0.1 1" mass="0.05"/>
      <freejoint/>
    </body>
    <body name="blue_block" pos="0.28 -0.07 0.02">
      <geom name="blue_block_geom" type="box" size="0.02 0.02 0.02" rgba="0.1 0.1 0.8 1" mass="0.05"/>
      <freejoint/>
    </body>

    <!-- Placement targets (flat mats) -->
    <body name="blue_target" pos="0.25 0.1 0.001">
      <geom name="blue_target_geom" type="cylinder" size="0.05 0.001" rgba="0.1 0.1 0.8 1"/>
    </body>
    <body name="red_target" pos="0.15 0.15 0.001">
      <geom name="red_target_geom" type="cylinder" size="0.05 0.001" rgba="0.8 0.1 0.1 1"/>
    </body>

    <!-- Obstacles between red block and blue target -->
    <body name="obstacle_1" pos="0.18 0.0 0.05" mocap="true">
      <geom name="obstacle_1_geom" type="cylinder" size="0.015 0.05" rgba="0.15 0.15 0.15 1"/>
    </body>
    <body name="obstacle_2" pos="0.25 0.0 0.05" mocap="true">
      <geom name="obstacle_2_geom" type="cylinder" size="0.015 0.05" rgba="0.15 0.15 0.15 1"/>
    </body>

    <!-- Cameras matching X-VLA WidowX training setup (BridgeData) -->

    <!-- Primary camera - over-the-(right)-shoulder view (BridgeData primary camera) -->
    <camera name="primary" pos="0.0 -0.2 0.4" xyaxes="0.5 -0.7 0  0.5 0.5 0.6" mode="fixed" fovy="39"/>

    <!-- Additional third-person view for debugging -->
    <camera name="third_person" pos="0.5 0.5 0.4" xyaxes="-1 1 0 -0.5 -0.5 1" mode="fixed"/>
  </worldbody>
</mujoco>
